# .env.example
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_measurement_id_here

# Blog (see PATCH14-STEPS.md for how to get these)
# Neon Postgres connection string - powers the blog and its admin panel.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# User ID + password to log in to the admin panel at app.numrexo.com.
ADMIN_USER_ID=choose-a-login-id
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=a-long-random-string
# Vercel Blob Storage token, for uploading images from the admin editor (see
# PATCH15-STEPS.md). Only needed locally if you run `npm run dev` and test
# uploads before deploying - on Vercel itself this is added automatically
# once Blob Storage is connected to the project, no copy-pasting needed.
BLOB_READ_WRITE_TOKEN=

# "Email me this result" (Patch 20). Uses Resend (resend.com); see PATCH20-STEPS.md.
# API key from the Resend dashboard (starts with re_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender. The domain must be verified in Resend, e.g.  Numrexo <results@numrexo.com>
EMAIL_FROM=Numrexo <results@numrexo.com>
# Optional: where replies go.
EMAIL_REPLY_TO=
# Set to true to SHOW the "Email me this result" button (only after the two lines above work).
NEXT_PUBLIC_EMAIL_RESULT_ENABLED=false
# Optional safety cap on result emails per rolling 24 hours (default 80; Resend's free plan allows about 100/day).
EMAIL_RESULT_DAILY_CAP=80

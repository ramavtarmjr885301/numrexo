+}
+
+/* ------------------------------------------------------------------------
+   Blog article typography (Patch 21)
+
+   The blog pages used Tailwind's "prose" classes, but the typography plugin
+   is not installed, so those classes did nothing and Tailwind's reset left
+   headings looking like plain text, lists without bullets and tables without
+   borders. This block styles the article HTML directly. The admin editor's
+   live preview uses the same class, so what is written is what is published.
+   ------------------------------------------------------------------------ */
+.blog-content { color: #374151; font-size: 1.0625rem; line-height: 1.8; overflow-wrap: anywhere; }
+.blog-content > *:first-child { margin-top: 0; }
+.blog-content p { margin: 0 0 1.15em; }
+.blog-content h2 { font-size: 1.65rem; line-height: 1.25; font-weight: 800; color: #111111; margin: 2.2em 0 0.7em; padding-bottom: 0.35em; border-bottom: 2px solid #e2e8f0; letter-spacing: -0.01em; }
+.blog-content h3 { font-size: 1.3rem; line-height: 1.3; font-weight: 700; color: #111111; margin: 1.8em 0 0.5em; }
+.blog-content h2, .blog-content h3 { scroll-margin-top: 6rem; }
+.blog-content h4 { font-size: 1.1rem; font-weight: 700; color: #111111; margin: 1.5em 0 0.4em; }
+.blog-content strong, .blog-content b { font-weight: 700; color: #111111; }
+.blog-content em, .blog-content i { font-style: italic; }
+.blog-content a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
+.blog-content a:hover { color: #1e40af; }
+.blog-content ul { list-style: disc; padding-left: 1.5em; margin: 0 0 1.2em; }
+.blog-content ol { list-style: decimal; padding-left: 1.6em; margin: 0 0 1.2em; }
+.blog-content li { margin: 0.4em 0; padding-left: 0.2em; }
+.blog-content li::marker { color: #2563eb; font-weight: 700; }
+.blog-content li > ul, .blog-content li > ol { margin: 0.4em 0 0.4em; }
+.blog-content blockquote { margin: 1.5em 0; padding: 0.9em 1.2em; border-left: 4px solid #2563eb; background: #eff6ff; border-radius: 0 0.75rem 0.75rem 0; color: #1e3a8a; }
+.blog-content blockquote p:last-child { margin-bottom: 0; }
+.blog-content img { display: block; max-width: 100%; height: auto; margin: 1.6em auto; border-radius: 0.75rem; border: 1px solid #e2e8f0; }
+.blog-content figure { margin: 1.6em 0; }
+.blog-content figcaption { text-align: center; font-size: 0.85rem; color: #6b7280; margin-top: 0.5em; }
+.blog-content hr { border: 0; border-top: 2px solid #e2e8f0; margin: 2.2em 0; }
+.blog-content code { background: #f1f5f9; border: 1px solid #e2e8f0; padding: 0.12em 0.4em; border-radius: 0.35rem; font-size: 0.9em; }
+.blog-content pre { background: #0f172a; color: #e2e8f0; padding: 1em 1.2em; border-radius: 0.75rem; overflow-x: auto; margin: 1.4em 0; font-size: 0.9rem; line-height: 1.6; }
+.blog-content pre code { background: transparent; border: 0; padding: 0; color: inherit; }
+.blog-content table { display: block; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.6em 0; font-size: 0.95rem; line-height: 1.5; }
+.blog-content th { background: #f1f5f9; color: #111111; font-weight: 700; text-align: left; white-space: nowrap; }
+.blog-content th, .blog-content td { border: 1px solid #cbd5e1; padding: 0.6em 0.9em; vertical-align: top; }
+.blog-content tr:nth-child(even) td { background: #f8fafc; }
+@media (max-width: 640px) {
+  .blog-content { font-size: 1rem; }
+  .blog-content h2 { font-size: 1.4rem; }
+  .blog-content h3 { font-size: 1.15rem; }
+}
+
+
+/* ---- Visibility / contrast (Patch 21) -------------------------------------
+   Calculator panels and form fields were too faint for people with weak
+   eyesight. Cards get a firmer border plus a soft shadow, and every input
+   gets a clearly visible edge. */
+.bg-surface.border-hairline.rounded-xl,
+.bg-surface.border-hairline.rounded-2xl,
+.bg-surface.border-hairline.rounded-xl2 {
+  border-color: #b4bfce;
+  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
+}
+input.border-hairline,
+select.border-hairline,
+textarea.border-hairline {
+  border-color: #8a96a8;
+}
+input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid #2563eb;
+  outline-offset: 1px;
+}
+input::placeholder,
+textarea::placeholder {
+  color: #7b8494;
+  opacity: 1;
+}

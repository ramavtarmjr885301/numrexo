+              tab === t.key ? "bg-ink text-white" : "text-ink-soft hover:text-ink"
+            }`}
+          >
+            {t.label}
+          </button>
+        ))}
+      </div>
+
+      {tab === "percent" && (
+        <div className="space-y-5">
